# Required
DATABASE_URL="postgres://mobited:mobited@localhost:5432/mobited"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Image storage (Vercel Blob). Without it, development stores uploads in ./.uploads
BLOB_READ_WRITE_TOKEN=""

# Optional
# Public base URL. On Vercel it is derived from the deployment URL when empty.
APP_URL="http://localhost:3000"
# Email delivery via Resend. Without it, emails are logged and shown at /dev/poshta in development.
RESEND_API_KEY=""
EMAIL_FROM="MobiTed <no-reply@mobited.bg>"
# Protects /api/cron/* endpoints. Vercel Cron sends it automatically when set.
CRON_SECRET=""
